#version 450
// Store variant of shared2_wrap.comp (store_shared2_amd instead of load_shared2_amd).
// Reproducer: nir_opt_offsets try_fold_shared2 assertion `st64 || normal` for a constant shared address
// that wraps around. Valid shader: the out-of-bounds stores are in a branch that is never taken.
//
// 128 x 1 x 1 workgroup: larger than one subgroup, so the shared array stays in LDS.
// gl_LocalInvocationID.y is the constant 0 after NIR lowering, so "row - 1u" folds to 0xffffffff
// (shared byte address 0xfffffffc) and "row + 31u" to byte address 124.
layout(local_size_x = 128) in;

layout(set = 0, binding = 0) buffer Buf {
    uint take_oob_path; // the host writes 0: the guarded branch below never executes
    uint pad[3];
    uint result[];
};

shared uint s[128];

void main()
{
    uint lid = gl_LocalInvocationID.x;
    uint row = gl_LocalInvocationID.y; // always 0
    uint gid = gl_GlobalInvocationID.x;

    s[lid] = gid * 3u;
    barrier();

    uint r = s[127u - lid];
    if (take_oob_path != 0u) {
        // Never executed. The two stores are 128 bytes apart in one block; the load/store vectorizer
        // merges them into store_shared2_amd(0xfffffffc, offset0=0, offset1=32).
        s[row - 1u] = r;
        s[row + 31u] = r + 1u;
    }
    result[gid] = r;
}
