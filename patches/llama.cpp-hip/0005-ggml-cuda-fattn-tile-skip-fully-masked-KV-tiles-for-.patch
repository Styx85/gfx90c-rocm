From 5256297687524e105c4a2b342f5015b0d7a5bc34 Mon Sep 17 00:00:00 2001
From: Christoph Berliner <32103696+Styx85@users.noreply.github.com>
Date: Wed, 18 Nov 2026 23:46:09 +0100
Subject: [PATCH 05/11] ggml-cuda: fattn-tile: skip fully masked KV tiles for
 single-column Q, smaller decode tiles on GCN

For token generation (ncols1 == 1) the tile kernel processed the whole
padded KV cache, including tiles whose mask is -inf everywhere. Check the
mask per tile with __syncthreads_or and skip such tiles. Combined with a
smaller tile for DKQ=DV=128, ncols=2 on GCN (64 threads, nbatch_fa 32, up to
8 KV splits instead of 2) the decode FA kernel on gfx90c drops from 38.9 to
21.0 us per call (Qwen3-0.6B, tg128).

Co-Authored-By: Claude <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/fattn-tile.cuh | 31 +++++++++++++++++++++++++++++--
 1 file changed, 29 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index 177b2f0..36f1f54 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -199,7 +199,7 @@ static constexpr __host__ __device__ uint32_t ggml_cuda_fattn_tile_get_config_am
     GGML_CUDA_FATTN_TILE_CONFIG_CASE(112, 112, 32, 256, 2,  32,  56)
     GGML_CUDA_FATTN_TILE_CONFIG_CASE(112, 112, 64, 256, 2,  32,  56)
 
-    GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128,  2, 256, 2, 128,  64)
+    GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128,  2,  64, 8,  32,  64)
     GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128,  4, 128, 2,  64, 128)
     GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128,  8, 256, 2,  64, 128)
     GGML_CUDA_FATTN_TILE_CONFIG_CASE(128, 128, 16, 256, 2,  64, 128)
@@ -954,17 +954,41 @@ static __global__ void flash_attn_tile(
 
     // Main loop over KV cache:
     const int k_VKQ_max = KV_max ? KV_max[sequence*gridDim.x + blockIdx.x] : ne11;
+
+    // For a single Q column (token generation) skip KV tiles whose mask is -inf everywhere,
+    // e.g. the unused tail of a partially filled KV cache. All threads take the same branch.
+    const auto tile_fully_masked = [&](const int k_VKQ_0) -> bool {
+        if constexpr (ncols1 != 1) {
+            return false;
+        }
+        if (!maskh) {
+            return false;
+        }
+        const int j = fastmodulo(col_Q_0, ne01);
+        int any_unmasked = 0;
+        for (int k = threadIdx.y*warp_size + threadIdx.x; k < nbatch_fa; k += nwarps*warp_size) {
+            if (k_VKQ_0 + k < k_VKQ_max) {
+                any_unmasked |= !isinf(__half2float(maskh[j*stride_mask + k_VKQ_0 + k]));
+            }
+        }
+        return !__syncthreads_or(any_unmasked);
+    };
+
     if (ncols2 == 1) {
         // Branch with out-of-bounds checks.
         int k_VKQ_0 = blockIdx.y*nbatch_fa;
         while (k_VKQ_0 <= k_VKQ_max - nbatch_fa) {
+            if (tile_fully_masked(k_VKQ_0)) {
+                k_VKQ_0 += gridDim.y*nbatch_fa;
+                continue;
+            }
             constexpr bool oob_check = false;
             flash_attn_tile_iter<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K, use_logit_softcap, oob_check>
                 (Q_tmp, K_h2, V_h2, maskh, ne01, logit_softcap, slope, KQ, KV_tmp,
                 stride_K2, stride_V2, stride_mask, KQ_max, KQ_sum, VKQ, k_VKQ_0, k_VKQ_max, col_Q_0);
             k_VKQ_0 += gridDim.y*nbatch_fa;
         }
-        if (k_VKQ_0 < k_VKQ_max) {
+        if (k_VKQ_0 < k_VKQ_max && !tile_fully_masked(k_VKQ_0)) {
             constexpr bool oob_check = true;
             flash_attn_tile_iter<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K, use_logit_softcap, oob_check>
                 (Q_tmp, K_h2, V_h2, maskh, ne01, logit_softcap, slope, KQ, KV_tmp,
@@ -973,6 +997,9 @@ static __global__ void flash_attn_tile(
     } else {
         // Branch without out-of-bounds checks.
         for (int k_VKQ_0 = blockIdx.y*nbatch_fa; k_VKQ_0 < k_VKQ_max; k_VKQ_0 += gridDim.y*nbatch_fa) {
+            if (tile_fully_masked(k_VKQ_0)) {
+                continue;
+            }
             constexpr bool oob_check = false;
             flash_attn_tile_iter<warp_size, nwarps, ncols1, ncols2, DKQ, DV, nbatch_fa, nbatch_K, use_logit_softcap, oob_check>
                 (Q_tmp, K_h2, V_h2, maskh, ne01, logit_softcap, slope, KQ, KV_tmp,
