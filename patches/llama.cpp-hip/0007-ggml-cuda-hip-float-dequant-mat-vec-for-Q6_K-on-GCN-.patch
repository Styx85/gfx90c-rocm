+template <ggml_type type> struct ggml_gcn_fmmv;
+
+template <> struct ggml_gcn_fmmv<GGML_TYPE_Q4_K> {
+    typedef block_q4_K block_t;
+    int v_im, q_offset, y_offset;
+    float4 y10, y132, y20, y232;
+    float  s10, s132, s20, s232;
+
+    __device__ __forceinline__ ggml_gcn_fmmv(const int itid) {
+        const int il   = itid / 4;
+        const int ir   = itid % 4;
+        const int v_in = il % 2;
+        const int l0   = 4*(2*ir + v_in);
+        v_im     = il / 2;
+        q_offset = 32*v_im + l0;
+        y_offset = 64*v_im + l0;
+    }
+
+    __device__ __forceinline__ void load_y(const float * __restrict__ yb) {
+        yb  += y_offset;
+        y10  = *(const float4 *) (yb +   0);
+        y132 = *(const float4 *) (yb +  32);
+        y20  = *(const float4 *) (yb + 128);
+        y232 = *(const float4 *) (yb + 160);
+        s10  = ggml_gcn_sum4(y10);
+        s132 = ggml_gcn_sum4(y132);
+        s20  = ggml_gcn_sum4(y20);
+        s232 = ggml_gcn_sum4(y232);
+    }
+
+    __device__ __forceinline__ float dot(const block_t * __restrict__ b) const {
+        const float2     dm   = __half22float2(b->dm);
+        const uint16_t * sc16 = (const uint16_t *) b->scales;
+
+        const uint32_t scale0 = sc16[v_im + 0];
+        const uint32_t scale4 = sc16[v_im + 2];
+        const uint32_t scale8 = sc16[v_im + 4];
+        const uint32_t s04l   = (scale4 << 16) | scale0;
+        const uint32_t s04h   = (s04l & 0xC0C0C0C0u) >> 2;
+        const uint32_t s04    = s04l & 0x3F3F3F3Fu;
+        const uint32_t s8     = (((scale8 << 12) | scale8) & 0x0F0F0F0Fu) | s04h;
+
+        const uint32_t q0  = *(const uint32_t *) (b->qs + q_offset);
+        const uint32_t q64 = *(const uint32_t *) (b->qs + q_offset + 64);
+
+        const float sx = ggml_gcn_dot4_u8( q0        & 0x0F0F0F0Fu, y10);
+        const float sy = ggml_gcn_dot4_u8((q0  >> 4) & 0x0F0F0F0Fu, y132);
+        const float sz = ggml_gcn_dot4_u8( q64       & 0x0F0F0F0Fu, y20);
+        const float sw = ggml_gcn_dot4_u8((q64 >> 4) & 0x0F0F0F0Fu, y232);
+
+        const float sum_d = sx*ggml_gcn_ubyte(s04, 0) + sy*ggml_gcn_ubyte(s04, 1) + sz*ggml_gcn_ubyte(s8, 0) + sw*ggml_gcn_ubyte(s8, 1);
+        const float sum_m = s10*ggml_gcn_ubyte(s04, 2) + s132*ggml_gcn_ubyte(s04, 3) + s20*ggml_gcn_ubyte(s8, 2) + s232*ggml_gcn_ubyte(s8, 3);
+
+        return dm.x*sum_d - dm.y*sum_m;
+    }
+};
