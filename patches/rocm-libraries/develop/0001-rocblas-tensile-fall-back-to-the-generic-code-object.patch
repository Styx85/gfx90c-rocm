From a8bdd0df07ae66f48a743b916d71d41bdd7c6021 Mon Sep 17 00:00:00 2001
From: Christoph Berliner <32103696+Styx85@users.noreply.github.com>
Date: Thu, 19 Nov 2026 01:00:07 +0100
Subject: [PATCH] rocblas/tensile: fall back to the generic code-object family
 library

When no Tensile library exists for the exact GPU architecture (e.g. gfx90c,
the Vega APU in Renoir/Cezanne), rocBLAS aborts with 'Cannot read
TensileLibrary_lazy_gfx90c.dat' although the gfx9-generic library, whose
code objects the runtime can load on gfx90c, is installed.

- rocBLAS: if neither the exact nor the strict catalog has a library, use
  the catalog of the architecture's LLVM generic family (gfx9-generic,
  gfx9-4-generic, gfx10-1-generic, gfx10-3-generic, gfx11-generic,
  gfx12-generic) as catalog key. It selects the library path, the code
  object glob and the helper kernel; library maps stay keyed by the
  hardware architecture, like for the strict catalog.
- Tensile: do not append the hardware architecture to a fallback library
  prefix that already ends in an architecture suffix (e.g.
  ..._fallback_gfx9-generic), which produced a non-existent
  ..._fallback_gfx9-generic_gfx90c.hsaco.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 projects/rocblas/library/src/tensile_host.cpp | 59 +++++++++++++++++++
 .../include/Tensile/PlaceholderLibrary.hpp    | 17 +++---
 2 files changed, 68 insertions(+), 8 deletions(-)

diff --git a/projects/rocblas/library/src/tensile_host.cpp b/projects/rocblas/library/src/tensile_host.cpp
index 56de313fc7d..a29ee4bfd6e 100644
--- a/projects/rocblas/library/src/tensile_host.cpp
+++ b/projects/rocblas/library/src/tensile_host.cpp
@@ -236,6 +236,29 @@ namespace
         }
     }
 
+    /*****************************************************************************
+     * Generic code-object family of a GPU architecture (LLVM "generic" targets).  *
+     * Used when no Tensile library exists for the exact architecture, e.g. gfx90c *
+     * (Vega APU) can use the gfx9-generic library. Returns "" if there is none.   *
+     *****************************************************************************/
+    std::string rocblas_tensile_generic_arch(const std::string& arch)
+    {
+        // generic target and its members, each member enclosed in spaces
+        static constexpr const char* families[][2] = {
+            {"gfx9-generic", " gfx900 gfx902 gfx904 gfx906 gfx909 gfx90c "},
+            {"gfx9-4-generic", " gfx940 gfx941 gfx942 gfx950 "},
+            {"gfx10-1-generic", " gfx1010 gfx1011 gfx1012 gfx1013 "},
+            {"gfx10-3-generic", " gfx1030 gfx1031 gfx1032 gfx1033 gfx1034 gfx1035 gfx1036 "},
+            {"gfx11-generic", " gfx1100 gfx1101 gfx1102 gfx1103 gfx1150 gfx1151 gfx1152 gfx1153 "},
+            {"gfx12-generic", " gfx1200 gfx1201 "},
+        };
+        const std::string token = " " + arch.substr(0, arch.find(':')) + " ";
+        for(const auto& family : families)
+            if(std::string_view(family[1]).find(token) != std::string_view::npos)
+                return family[0];
+        return "";
+    }
+
     Tensile::LazyLoadingInit getLazyLoadingArch(const std::string& deviceString)
     {
         if(deviceString.find("gfx803") != std::string::npos)
@@ -945,6 +968,42 @@ namespace
                 catalog_key = strict_catalog;
             }
 
+            // No Tensile library for the exact architecture (e.g. gfx90c): use the
+            // library of its LLVM generic family (e.g. gfx9-generic), whose code
+            // objects the runtime can load on this GPU. Library maps stay keyed by
+            // `processor`; the catalog key selects library path, code objects and
+            // the helper kernel.
+            auto has_arch_library = [&](const std::string& arch) {
+#ifdef TENSILE_YAML
+                const std::string ext = ".yaml";
+#else
+                const std::string ext = ".dat";
+#endif
+                const std::string xnack = rocblas_internal_get_xnack_mode();
+                std::vector<std::string> dirs;
+                if(!xnack.empty())
+                    dirs.push_back(base_path + "/" + arch + "-" + xnack);
+                dirs.push_back(base_path + "/" + arch);
+                dirs.push_back(base_path);
+                for(const auto& dir : dirs)
+                    if(TestPath(dir + "/TensileLibrary_lazy_" + arch + ext)
+                       || TestPath(dir + "/TensileLibrary_" + arch + ext))
+                        return true;
+                return false;
+            };
+            if(!has_arch_library(catalog_key))
+            {
+                std::string generic = rocblas_tensile_generic_arch(processor);
+                if(!generic.empty() && has_arch_library(generic))
+                {
+                    rocblas_internal_ostream msg;
+                    print_if_verbose(msg << "No Tensile library for GPU architecture '"
+                                         << processor << "'; using the '" << generic
+                                         << "' library.");
+                    catalog_key = generic;
+                }
+            }
+
             path = base_path;
             // Probe subdirectories from most-specific to least-specific so that shard
             // overlays compose correctly regardless of how TheRock splits arch builds:
diff --git a/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp b/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
index 19213f92217..623e81589f6 100644
--- a/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
+++ b/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
@@ -213,15 +213,16 @@ namespace Tensile
                 {
                     // Idempotent: producer may already have suffixed the
                     // filePrefix with "_<arch>" (per-arch fallback routing).
-                    // Don't double-append.
-                    const std::string archSuffix = std::string("_") + arch;
-                    if(coFileDependency.size() < archSuffix.size()
-                       || coFileDependency.compare(coFileDependency.size() - archSuffix.size(),
-                                                   archSuffix.size(),
-                                                   archSuffix)
-                              != 0)
+                    // That arch may also be a generic target (e.g. gfx9-generic)
+                    // that differs from the hardware arch (e.g. gfx90c) when the
+                    // generic library is used as fallback. Don't double-append.
+                    const auto lastUnderscore = coFileDependency.rfind('_');
+                    const bool hasArchSuffix
+                        = lastUnderscore != std::string::npos
+                          && coFileDependency.compare(lastUnderscore + 1, 3, "gfx") == 0;
+                    if(!hasArchSuffix)
                     {
-                        coFileDependency += archSuffix;
+                        coFileDependency += std::string("_") + arch;
                     }
                     coFileDependency += std::string(".hsaco");
                 }
-- 
