From 64f19c8f89ad773f5e8145244e458ba5ad9462fb Mon Sep 17 00:00:00 2001
From: Christoph Berliner <32103696+Styx85@users.noreply.github.com>
Date: Thu, 19 Nov 2026 07:01:05 +0100
Subject: [PATCH 3/4] tensile: set code object file names for preloaded
 placeholder libraries

Placeholder libraries of the running architecture are preloaded at
deserialization time via loadPlaceholderLibrary() without hardware.
Their solutions are inserted into the master solution map without a
codeObjectFilename. The normal selection path sets the name on every
findBestSolution()/findAllSolutions() call, but solutions reached by
index do not pass through it:

- MasterSolutionLibrary::setOverridesFromFile() (rocBLAS
  ROCBLAS_TENSILE_GEMM_OVERRIDE_PATH) finds the solution with
  getSolutionByIndex() and caches it as the override,
- rocBLAS solution-index GEMMs without a prior get_solutions call.

SolutionAdapter::launchKernel() then never loads the code object,
getKernel() returns hipErrorNotFound and rocblas_gemm_ex returns
rocblas_status_internal_error while leaving D untouched.

Record the code object file name for preloaded solutions wherever it
does not depend on the hardware (.co, non-fallback .hsaco, fallback
libraries whose prefix already carries the architecture). Fallback
libraries without an architecture suffix keep the old behaviour.

Tested on gfx90c (Ryzen 5 5600G) with an override file for the
llama.cpp prefill GEMM shapes: before, every overridden problem failed
with internal_error; after, results match the double reference and
llama.cpp pp512 runs with the overridden solutions.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../include/Tensile/PlaceholderLibrary.hpp    | 21 ++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp b/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
index c308590da1f..07e9352779d 100644
--- a/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
+++ b/shared/tensile/Tensile/Source/lib/include/Tensile/PlaceholderLibrary.hpp
@@ -169,6 +169,18 @@ namespace Tensile
                 std::lock_guard<std::mutex> lock(*solutionsGuard);
                 if(hardware == nullptr)
                 {
+                    // Preloaded at deserialization time, before any hardware is known. Still
+                    // record the code object file wherever it does not depend on the hardware:
+                    // solutions in this library can also be reached by index (problem override
+                    // files, explicit solution indices) without passing through
+                    // findBestSolution/findAllSolutions, which would otherwise set it, and
+                    // their code object would never be loaded.
+                    for(auto& i : mLibrary->solutions)
+                    {
+                        auto coFile = getCodeObjectFileName(std::string(), *i.second);
+                        if(!coFile.empty())
+                            i.second->codeObjectFilename = coFile;
+                    }
                     masterSolutions->insert(mLibrary->solutions.begin(), mLibrary->solutions.end());
                 }
                 else
@@ -191,12 +203,17 @@ namespace Tensile
 
         std::string getCodeObjectFileName(Hardware const&   hardware,
                                           MySolution const& solution) const
+        {
+            return getCodeObjectFileName(hardware.archName(), solution);
+        }
+
+        // Returns an empty string if the name depends on the architecture and arch is empty.
+        std::string getCodeObjectFileName(std::string arch, MySolution const& solution) const
         {
             std::string coFileDependency = filePrefix;
 
             if(solution.isSourceKernel())
             {
-                std::string arch = hardware.archName();
                 //Remove xnack information if present
                 auto pos = arch.find(":");
                 if(pos != std::string::npos)
@@ -215,6 +232,8 @@ namespace Tensile
                           && coFileDependency.compare(lastUnderscore + 1, 3, "gfx") == 0;
                     if(!hasArchSuffix)
                     {
+                        if(arch.empty())
+                            return std::string();
                         coFileDependency += std::string("_") + arch;
                     }
                     coFileDependency += std::string(".hsaco");
